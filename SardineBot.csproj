<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <RootNamespace>SardineBot</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Google.Apis.Auth" Version="1.72.0"/>
        <PackageReference Include="Google.Apis.Sheets.v4" Version="1.70.0.3819"/>
        <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.10"/>
        <PackageReference Include="NetCord" Version="1.0.0-alpha.445"/>
        <PackageReference Include="NetCord.Hosting" Version="1.0.0-alpha.445"/>
        <PackageReference Include="NetCord.Hosting.AspNetCore" Version="1.0.0-alpha.445"/>
        <PackageReference Include="NetCord.Hosting.Services" Version="1.0.0-alpha.445"/>
        <PackageReference Include="NetCord.Services" Version="1.0.0-alpha.445"/>
        <PackageReference Include="SQLite" Version="3.13.0"/>
    </ItemGroup>

    <ItemGroup>
        <None Update="Config\appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
